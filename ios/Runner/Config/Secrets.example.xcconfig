// Copy this file to Secrets.xcconfig (same directory) and fill in a real
// key before building for iOS. Secrets.xcconfig is gitignored — never
// commit it.
//
// MANUAL STEP required before shipping: restrict the real key in Google
// Cloud Console to this app's iOS Bundle ID (com.ferrematica.express).
// sdd-apply cannot automate that step.
GOOGLE_MAPS_API_KEY = REPLACE_WITH_YOUR_DEV_MAPS_KEY
